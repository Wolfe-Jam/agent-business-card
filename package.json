{
  "name": "agent-business-card",
  "version": "0.1.1",
  "description": "Render a business card for an AI agent, an MCP server or a person, and print it to screen as one self-contained HTML page: front and back, flip, light/dark, landscape/portrait.",
  "keywords": [
    "business-card",
    "agent-card",
    "server-card",
    "mcp",
    "a2a",
    "html",
    "card"
  ],
  "author": "James Wolfe",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfe-Jam/agent-business-card.git"
  },
  "homepage": "https://github.com/Wolfe-Jam/agent-business-card#readme",
  "bugs": "https://github.com/Wolfe-Jam/agent-business-card/issues",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=80 \"test/*.test.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
