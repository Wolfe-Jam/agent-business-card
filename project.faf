faf_version: "3.0"
project:
  name: agent-business-card
  goal: "Render a business card for an AI agent, an MCP server or a person, and print it to screen as one self-contained HTML page: front and back, flip, light/dark, landscape/portrait."
  main_language: TypeScript
  type: library  # found: no classifying signals — fallback
